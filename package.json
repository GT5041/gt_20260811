{
  "name": "return-billing-mcp-server",
  "version": "1.0.0",
  "description": "返品・請求問い合わせ振り分け MCP サーバー (CCAR-F 認定試験学習用サンプル実装)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "return-billing-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/httpServer.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/httpServer.ts",
    "test": "npm run build && node --test tests/integration.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
